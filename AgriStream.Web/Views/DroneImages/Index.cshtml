@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Drone Images";
    var farms = ViewBag.Farms as List<SelectListItem> ?? new();
}

<div class="container py-5" style="max-width:800px">

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <h2 class="fw-bold text-success">
            Drone Image Upload
        </h2>

        <p class="text-muted">
            Upload agricultural drone images to Azure Blob Storage.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-action="Upload"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Select Farm</label>

                <select name="farmId"
                        asp-items="farms"
                        class="form-select"
                        required>
                    <option value="">-- Select Farm --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Drone Image</label>

                <input type="file"
                       name="image"
                       accept=".jpg,.jpeg,.png,.webp"
                       class="form-control"
                       required />
            </div>

            <button class="btn btn-success"
                    type="submit"
                    disabled="@(!farms.Any())">
                Upload to Azure
            </button>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-light">
                Back to Dashboard
            </a>

        </form>

    </div>

</div>

