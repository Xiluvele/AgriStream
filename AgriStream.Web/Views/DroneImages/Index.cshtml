@model List<AgriStream.Web.Controllers.DroneImageItem>

@{
    ViewData["Title"] = "Drone Images";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center
        flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold text-success mb-1">
                Drone Images
            </h2>

            <p class="text-muted mb-0">
                View agricultural drone images stored
                in Azure Blob Storage.
            </p>
        </div>

        <a asp-controller="DroneImages"
           asp-action="Create"
           class="btn btn-success px-4">
            + Upload Image
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">

            <h4>No Drone Images Uploaded</h4>

            <p class="text-muted">
                Upload your first drone image to start
                monitoring your agricultural farms.
            </p>

            <div>
                <a asp-action="Create"
                   class="btn btn-success">
                    Upload First Image
                </a>
            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var image in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm
                        rounded-4 h-100 overflow-hidden">

                        <a href="@image.ImageUrl"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img src="@image.ImageUrl"
                                 alt="Drone image of @image.FarmName"
                                 class="card-img-top"
                                 style="height:220px;
                            object-fit:cover;" />

                        </a>

                        <div class="card-body">

                            <h6 class="fw-bold text-success">
                                @image.FarmName
                            </h6>

                            <p class="text-muted small mb-2">
                                @image.FileName
                            </p>

                            <p class="small text-muted">
                                Uploaded:
                                @(image.UploadedAt?.ToLocalTime()
                                    .ToString("dd MMM yyyy HH:mm")
                                    ?? "Unknown")
                            </p>

                            <a href="@image.ImageUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-success btn-sm">
                                View Full Image
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>
