@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Upload Drone Image";
    var farms = ViewBag.Farms as List<SelectListItem>
        ?? new List<SelectListItem>();
}

<div class="container py-5" style="max-width:800px">

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <h2 class="fw-bold text-success">
            Upload Drone Image
        </h2>

        <p class="text-muted">
            Upload agricultural drone images to Azure Blob Storage.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-controller="DroneImages"
              asp-action="Upload"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">
                    Select Farm
                </label>

                <select name="farmId"
                        asp-items="farms"
                        class="form-select"
                        required>
                    <option value="">
                        -- Select Farm --
                    </option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Drone Image
                </label>

                <input type="file"
                       name="image"
                       accept=".jpg,.jpeg,.png,.webp"
                       class="form-control"
                       required />

                <small class="text-muted">
                    Supported formats: JPG, PNG, WebP.
                    Maximum size: 5 MB.
                </small>
            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-success"
                        disabled="@(!farms.Any())">
                    Upload to Azure
                </button>

                <a asp-controller="DroneImages"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>
