@model AgriStream.Web.ViewModels.Farms.FarmDetailsViewModel

@{
    ViewData["Title"] = "Delete Farm";
}

<div class="container py-5" style="max-width:650px;">

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <h2 class="fw-bold text-danger mb-3">
            Delete Farm
        </h2>

        <div class="alert alert-warning">
            Are you sure you want to delete this farm?
            This action cannot be undone.
        </div>

        <h4 style="color:#173c2a;">
            @Model.FarmName
        </h4>

        <p class="text-muted">
            Location: @Model.Location
        </p>

        @if (Model.DeviceCount > 0)
        {
            <div class="alert alert-danger">
                This farm has @Model.DeviceCount registered
                device(s). Remove or reassign those devices
                before deleting the farm.
            </div>
        }

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit"
                    class="btn btn-danger"
                    disabled="@(Model.DeviceCount > 0)">
                Confirm Delete
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                Cancel
            </a>

        </form>

    </div>

</div>
