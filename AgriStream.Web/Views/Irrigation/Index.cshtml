@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Irrigation Management";

    var devices = ViewBag.Devices as List<SelectListItem>
        ?? new List<SelectListItem>();
}

<div class="container py-5" style="max-width:850px">

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <h2 class="fw-bold text-success">
            Irrigation Management
        </h2>

        <p class="text-muted">
            Send irrigation commands to farm devices
            using Azure Queue Storage.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-controller="Irrigation"
              asp-action="SendCommand"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">
                    Select Irrigation Device
                </label>

                <select name="deviceId"
                        asp-items="devices"
                        class="form-select"
                        required>
                    <option value="">
                        -- Select Device --
                    </option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Irrigation Command
                </label>

                <select name="command"
                        class="form-select"
                        required>
                    <option value="">
                        -- Select Command --
                    </option>
                    <option value="Start">
                        Start Irrigation
                    </option>
                    <option value="Stop">
                        Stop Irrigation
                    </option>
                </select>
            </div>

            <button type="submit"
                    class="btn btn-success"
                    disabled="@(!devices.Any())">
                Send Command
            </button>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Dashboard
            </a>

        </form>

    </div>

</div>
